{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Ada-editor design tokens. Three tiers: primitive -> semantic -> component. Every foreground token carries an $extensions.ada.contrast assertion that scripts/verify-tokens.mjs enforces in CI. Severity tokens carry an $extensions.ada.channels list; the verifier refuses any severity set that relies on colour alone.",
  "primitive": {
    "$description": "Raw ramps. Never referenced directly by components.",
    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "50": {
