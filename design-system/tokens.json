  "semantic": {
    "light": {
      "surface": {
        "canvas": {
          "$type": "color",
          "$value": "{primitive.neutral.0}"
        },
        "raised": {
          "$type": "color",
          "$value": "{primitive.neutral.0}"
        },
        "sunken": {
          "$type": "color",
          "$value": "{primitive.neutral.50}"
        },
        "overlay": {
          "$type": "color",
          "$value": "{primitive.neutral.0}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{primitive.neutral.900}",
          "$extensions": {
            "ada": {
              "contrast": {
                "against": "semantic.light.surface.canvas",
                "min": 7
              }
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "{primitive.neutral.600}",
          "$extensions": {
            "ada": {
              "contrast": {
                "against": "semantic.light.surface.canvas",
                "min": 4.5
              }
            }
          }
        },
        "tertiary": {
          "$type": "color",
          "$value": "{primitive.neutral.500}",
          "$extensions": {
            "ada": {
              "contrast": {
                "against": "semantic.light.surface.canvas",
