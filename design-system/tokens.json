        "inverse": {
          "$type": "color",
          "$value": "{primitive.neutral.0}",
          "$extensions": {
            "ada": {
              "contrast": {
                "against": "semantic.light.action.primary.bg",
                "min": 4.5
              }
            }
          }
        }
      },
      "border": {
        "subtle": {
          "$type": "color",
          "$value": "{primitive.neutral.200}",
          "$extensions": {
            "ada": {
              "decorative": true
            }
          }
        },
        "default": {
          "$type": "color",
          "$value": "{primitive.neutral.300}",
          "$extensions": {
            "ada": {
              "decorative": true
            }
          }
        },
