  "encoding": {
    "$description": "The non-colour channels that actually carry severity meaning. Colour is listed last and deliberately marked redundant. verify-tokens.mjs fails the build if any severity declares fewer than two non-colour channels.",
    "blocker": {
      "underline": "double",
      "glyph": "octagon",
      "label": "Blocks access",
      "wcag": "Fails Level A",
      "channels": [
        "underline",
        "glyph",
        "label",
        "colour"
      ]
    },
    "violation": {
      "underline": "wavy",
      "glyph": "triangle",
      "label": "Fails AA",
      "wcag": "Fails Level AA",
      "channels": [
        "underline",
        "glyph",
        "label",
        "colour"
      ]
    },
    "advisory": {
      "underline": "dotted",
      "glyph": "circle-i",
      "label": "Advisory",
      "wcag": "AAA / best practice",
      "channels": [
        "underline",
        "glyph",
        "label",
        "colour"
      ]
    },
    "manual": {
      "underline": "dashed",
      "glyph": "diamond-q",
      "label": "Needs your call",
      "wcag": "Not machine-decidable",
      "channels": [
        "underline",
        "glyph",
        "label",
        "colour"
      ]
    },
    "checked": {
      "underline": "none",
      "glyph": "check",
      "label": "Rule passed",
      "wcag": "No finding for this rule",
      "channels": [
        "glyph",
        "label",
        "colour"
      ]
    }
  },
