{
  "name": "ada-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Write documents that meet WCAG 2.1 AA, Section 508 and PDF/UA.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:verify": "node scripts/verify-tokens.mjs --verbose",
    "contrast": "node scripts/verify-tokens.mjs --pair",
    "test": "node scripts/test-verifier.mjs",
    "palette:ceiling": "node scripts/palette-ceiling.mjs",
    "typecheck": "tsc --noEmit",
    "preview:build": "node scripts/build-preview.mjs",
    "a11y": "node scripts/verify-a11y.mjs",
    "verify": "npm run typecheck && node scripts/test-verifier.mjs && node scripts/verify-tokens.mjs && node scripts/build-preview.mjs && node scripts/verify-a11y.mjs && node scripts/verify-a11y-app.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "a11y:orca": "node scripts/verify-orca.mjs --verbose",
    "a11y:nvda": "playwright test --project=nvda",
    "a11y:voiceover": "playwright test --project=voiceover",
    "spike:corpus": "node scripts/spike/fetch-corpus.mjs",
    "spike": "node scripts/spike/report.mjs",
    "a11y:app": "node scripts/verify-a11y-app.mjs"
  },
  "comment": "Runtime deps are used by the design-system primitives. Dev deps drive the verification harness: tsc typechecks the components, esbuild renders them for the a11y gate, axe-core audits the result.",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "next": "^15.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.35.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.34.0",
    "@guidepup/playwright": "^0.19.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13",
    "marked": "^18.0.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
